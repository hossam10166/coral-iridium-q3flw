          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['refNo', 'groupNo', 'date', 'route', 'vehicleType', 'vehicleCount', 'pax', 'customer', 'supplier', 'currency', 'buy', 'sell', 'rate', 'driverName', 'plateNo', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(transportId) && hasWorkspaceAccess(userId) && userProfileExists(userId);
