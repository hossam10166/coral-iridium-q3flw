          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['groupNo', 'date', 'pax', 'customer', 'supplier', 'currency', 'buy', 'sell', 'rate', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(entryId) && hasWorkspaceAccess(userId) && userProfileExists(userId);
