        && existing().workspaceId == request.auth.uid
        && isValidWorkspaceInvite(incoming(), inviteId)
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().workspaceId == existing().workspaceId
        && incoming().invitedBy == existing().invitedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'permissions', 'updatedAt']);
      allow delete: if isValidId(inviteId) && isVerifiedUser()
        && existing().workspaceId == request.auth.uid;
    }

    // --- User Root Profile & Isolated PII ---
