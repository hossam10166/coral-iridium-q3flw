        resource.data.workspaceId == request.auth.uid
        || (request.auth.token.email is string && resource.data.email == request.auth.token.email.lower())
      );
      allow create: if isValidId(inviteId) && isVerifiedUser()
        && isValidWorkspaceInvite(incoming(), inviteId)
        && incoming().workspaceId == request.auth.uid
        && incoming().invitedBy == request.auth.uid
        && userProfileExists(request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
