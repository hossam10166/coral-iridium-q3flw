          && incoming().diff(existing()).affectedKeys().hasOnly(['refNo', 'groupNo', 'bookingDate', 'city', 'hotelName', 'confirmationNo', 'checkIn', 'checkOut', 'nights', 'roomType', 'mealPlan', 'rooms', 'pax', 'status', 'customer', 'supplier', 'currency', 'buy', 'sell', 'rate', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(hotelId) && hasWorkspaceAccess(userId) && userProfileExists(userId);
