        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'rate', 'lang', 'updatedAt']);
      allow delete: if false;

      match /googleMembers/{memberUid} {
        allow get: if isValidId(userId) && isValidId(memberUid) && (
          isOwner(userId) || (isVerifiedUser() && request.auth.uid == memberUid)
