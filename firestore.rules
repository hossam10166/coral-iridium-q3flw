        && isValidStr(data.assignedBus, 0, 80)
        && data.shiftStatus in ['on_duty', 'standby', 'off_duty']
        && isValidStr(data.notes, 0, 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Employee Staff Login Accounts ---
    match /staffAccounts/{staffUid} {
      allow get: if isValidId(staffUid) && (
        (isSignedIn() && request.auth.uid == staffUid)
        || (isVerifiedUser() && existing().workspaceId == request.auth.uid)
      );
      allow list: if isVerifiedUser() && resource.data.workspaceId == request.auth.uid;
      allow create: if isValidId(staffUid) && isVerifiedUser()
        && isValidStaffAccount(incoming(), staffUid)
        && incoming().workspaceId == request.auth.uid
        && incoming().createdBy == request.auth.uid
        && userProfileExists(request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(staffUid) && isVerifiedUser()
        && existing().workspaceId == request.auth.uid
        && isValidStaffAccount(incoming(), staffUid)
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'permissions', 'employeeId', 'updatedAt']);
      allow delete: if isValidId(staffUid) && isVerifiedUser()
        && existing().workspaceId == request.auth.uid;
    }

