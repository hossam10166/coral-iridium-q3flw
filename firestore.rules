          && get(/databases/$(database)/documents/workspaceInvites/$(incoming().inviteId)).data.workspaceId == userId
          && get(/databases/$(database)/documents/workspaceInvites/$(incoming().inviteId)).data.email == request.auth.token.email.lower()
